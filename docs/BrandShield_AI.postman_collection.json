        {
          "name": "Execute Labelled Benchmark Evaluation",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reviewer_token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/governance/evaluate-testset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "governance",
                "evaluate-testset"
              ]
            }
          }
        },
        {
          "name": "Verify SHA-256 Merkle Audit Chain (Admin Only)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/governance/audit-verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
