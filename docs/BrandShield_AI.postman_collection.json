{
  "info": {
    "name": "BrandShield AI - Enterprise API Collection",
    "_postman_id": "7b1bb31a-f2e6-4e16-b01e-06d5366686db",
    "description": "Complete production API suite for BrandShield AI (FastAPI, Async SQLAlchemy 2.0, pgvector, Merkle audit ledger).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "creator_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "reviewer_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "demo_brand_profile_id",
      "value": "00000000-0000-0000-0000-000000000001",
      "type": "string"
    },
    {
      "key": "submission_id",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{creator_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authentication & RBAC",
      "item": [
        {
          "name": "Login (Creator) - Save Token",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "creator@acmefintech.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "DemoSecure2026!",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.environment.set('creator_token', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login (Reviewer) - Save Token",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "reviewer@acmefintech.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "DemoSecure2026!",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.environment.set('reviewer_token', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Current Authenticated User",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Brand Profiles & Assets",
      "item": [
        {
          "name": "List Workspace Brand Profiles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/brands",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "brands"
              ]
            }
          }
        },
        {
          "name": "Get Specific Brand Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/brands/{{demo_brand_profile_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "brands",
                "{{demo_brand_profile_id}}"
              ]
            }
          }
        },
        {
          "name": "List Brand Visual Assets",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/brands/{{demo_brand_profile_id}}/assets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "brands",
                "{{demo_brand_profile_id}}",
                "assets"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Document Ingestion & AST",
      "item": [
        {
          "name": "Submit Raw Text Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/submissions/text",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "submissions",
                "text"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Acme Q3 Press Release Passage\",\n  \"brand_profile_id\": \"{{demo_brand_profile_id}}\",\n  \"content\": \"Acme FinTech provides a 100% risk-free settlement with a guaranteed monopoly.\",\n  \"document_type\": \"TEXT\"\n}"
            }
          }
        },
        {
          "name": "Upload Binary Document (PDF/DOCX)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/submissions/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "submissions",
                "upload"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Corporate Press Release Upload",
                  "type": "text"
                },
                {
                  "key": "brand_profile_id",
                  "value": "{{demo_brand_profile_id}}",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "demo_artifacts/acme_q3_press_release.pdf"
                }
              ]
            }
          }
        },
        {
          "name": "Get Submission by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/submissions/{{submission_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "submissions",
                "{{submission_id}}"
              ]
            }
          }
        },
        {
          "name": "List Revision DAG History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/submissions/{{submission_id}}/revisions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "submissions",
                "{{submission_id}}",
                "revisions"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Analysis Pipeline & Real-Time SSE",
      "item": [
        {
          "name": "Trigger Analysis on Submission",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/analysis/submissions/{{submission_id}}/run",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "analysis",
                "submissions",
                "{{submission_id}}",
                "run"
              ]
            }
          }
        },
        {
          "name": "Real-Time SSE Analysis Stream",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/submissions/{{submission_id}}/analyze/stream?token={{creator_token}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "submissions",
                "{{submission_id}}",
                "analyze",
                "stream"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "{{creator_token}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Workflow & Human Review Sign-Off",
      "item": [
        {
          "name": "Submit for Human Review",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/workflow/{{submission_id}}/submit-for-review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "workflow",
                "{{submission_id}}",
                "submit-for-review"
              ]
            }
          }
        },
        {
          "name": "Execute Review Decision (Reviewer Only)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reviewer_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/workflow/{{submission_id}}/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "workflow",
                "{{submission_id}}",
                "review"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"APPROVED\",\n  \"comments\": \"All terminology and claim verifications satisfied.\"\n}"
            }
          }
        },
        {
          "name": "Get Revision Lineage Token Diff",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/workflow/{{submission_id}}/revisions/diff?from_revision=1&to_revision=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "workflow",
                "{{submission_id}}",
                "revisions",
                "diff"
              ],
              "query": [
                {
                  "key": "from_revision",
                  "value": "1"
                },
                {
                  "key": "to_revision",
                  "value": "2"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Governance, Audit & Evaluation",
      "item": [
        {
          "name": "Get Governance Report (Recharts Formatted)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reviewer_token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/governance/reports",
              "host": [
                "{{baseUrl}}"
