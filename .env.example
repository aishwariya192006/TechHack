# BrandShield AI - Environment Configuration Example
# Copy this file to .env and adjust variables for your local or cloud environment.

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Production uses PostgreSQL 16+ with pgvector:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brandshield
# For quick local testing without PostgreSQL, SQLite can be used:
# DATABASE_URL=sqlite+aiosqlite:///brandshield.db

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
SECRET_KEY=brandshield_demo_secret_key_change_in_production_32bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# Analysis Engine & Demo Reliability
# -----------------------------------------------------------------------------
# DEMO_MODE enables rapid fallback cache if external LLM latency exceeds timeout
DEMO_MODE=true
# Configurable automation bias sample rate (default 15% = 0.15)
AUTOMATION_BIAS_SAMPLE_RATE=0.15
# Timeout watchdog for external AI calls in seconds
AI_REQUEST_TIMEOUT_SECONDS=4.0

# -----------------------------------------------------------------------------
# Optional External LLM Inference (Zero-Retention Enterprise Agreement)
# -----------------------------------------------------------------------------
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# CORS & Network Perimeter
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slashes):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://brandshield-frontend.onrender.com

# -----------------------------------------------------------------------------
# Frontend Build Environment (Vite)
# -----------------------------------------------------------------------------
# Backend API base URL passed during `npm run build` on Render or Vercel.
# Can be the full URL (e.g. https://brandshield-api.onrender.com) or host without protocol.
VITE_API_URL=https://brandshield-api.onrender.com

